# Hoist @prisma/client-runtime-utils to the workspace root node_modules so the
# custom-output Prisma client (apps/backend/src/generated/prisma) can resolve it.
# It is already a transitive dependency of @prisma/client (in the lockfile); this
# only fixes the install layout, it does not add a new dependency.
public-hoist-pattern[]=@prisma/client-runtime-utils
