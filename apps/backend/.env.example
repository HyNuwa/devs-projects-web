# Server
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRATION=900

# Community anti-spam and probable-duplicate window
COMMUNITY_WRITE_RATE_LIMIT=6
COMMUNITY_WRITE_RATE_TTL_MS=60000
COMMUNITY_DUPLICATE_WINDOW_DAYS=180

# Rate limiting (docs/README_SECURITY.md «Límites de frecuencia»)
# Without REDIS_URL, limits are counted in memory (development and tests).
# Production requires REDIS_URL and RATE_LIMIT_SECRET (32+ characters, e.g. `openssl rand -hex 32`).
# REDIS_URL=redis://localhost:6379
RATE_LIMIT_SECRET=change-me-to-a-strong-random-secret
# Proxy hops to trust for the client IP; 1 behind Nginx, 0 otherwise.
TRUST_PROXY=0

# Email (SMTP para producción / logs para desarrollo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@devsproject.local
