// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────────

enum Role {
  VISITOR
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum Shift {
  MANANA
  TARDE
  NOCHE
  NO_INDICO
}

enum CourseCondition {
  PROMO
  REGULAR
  LIBRE
  PREFIERO_NO_RESPONDER
}

enum ExamFormat {
  ESCRITO
  ORAL
  MIXTO
}

enum ExamSession {
  DICIEMBRE
  JULIO
  MARZO
  FEBRERO_MARZO
  ESPECIAL
  NO_RECUERDO
}

enum CourseAttempt {
  PRIMERA_CURSADA
  PRIMERA_RECURSADA
  SEGUNDA_O_MAS_RECURSADAS
  PREFIERO_NO_RESPONDER
}

enum CommunityDifficulty {
  MUY_BAJA
  BAJA
  MEDIA
  ALTA
  MUY_ALTA
}

enum ExamOutcome {
  APROBADO
  DESAPROBADO
  PREFIERO_NO_DECIR
}

enum ReportReason {
  SPAM_O_REPETIDO
  INSULTOS_O_ACOSO
  DATOS_PERSONALES
  NO_RELACIONADO
  POSIBLEMENTE_ENGANOSO
  OTRO
}

// Shared by every contribution type (materials, reseñas, experiencias). See
// docs/README_MODERACION.md and openspec/specs/moderation/publication.
enum PublicationStatus {
  PUBLISHED
  PENDING_REVIEW
  REJECTED
  HIDDEN
  REMOVED
}

enum MaterialResourceType {
  PARCIAL
  FINAL
  APUNTE
  RESUMEN
  TRABAJO_PRACTICO
  GUIA_EJERCICIOS
  OTRO
}

// ─── USER ──────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique @db.VarChar(30)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  displayName   String?   @map("display_name") @db.VarChar(50)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  bio           String?   @db.Text
  role          Role      @default(USER)
  points        Int       @default(0)
  level         Int       @default(1)
  emailVerified Boolean   @default(false) @map("email_verified")
  isBanned      Boolean   @default(false) @map("is_banned")
  isMuted       Boolean   @default(false) @map("is_muted")
  mutedUntil    DateTime? @map("muted_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLogin     DateTime? @map("last_login")

  studyPlans          UserStudyPlan[]
  materials           Material[]
  materialRatings     MaterialRating[]
  materialHelpfulness MaterialHelpfulness[]
  savedMaterials      SavedMaterial[]
  guides              Guide[]
  courseReviews       CourseReview[]         @relation("CourseReviewAuthor")
  examExperiences     ExamExperience[]       @relation("ExamExperienceAuthor")
  reports             Report[]               @relation("ReportReporter")
  decidedCases        ModerationCase[]       @relation("ModerationCaseDecidedBy")
  badges              UserBadge[]
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordResetRequest[]
  pointTransactions   PointTransaction[]

  @@map("users")
}

// ─── CARRERAS Y PLANES ─────────────────────────────────────────

model Career {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studyPlans StudyPlan[]

  @@map("careers")
}

model StudyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  careerId  String   @map("career_id") @db.Uuid
  name      String   @db.VarChar(150)
  code      String   @db.VarChar(50)
  duration  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  career   Career             @relation(fields: [careerId], references: [id], onDelete: Cascade)
  users    UserStudyPlan[]
  subjects StudyPlanSubject[]

  @@unique([careerId, code])
  @@map("study_plans")
}

model UserStudyPlan {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  studyPlanId String          @map("study_plan_id") @db.Uuid
  status      StudyPlanStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@unique([userId, studyPlanId])
  @@map("user_study_plans")
}

// ─── MATERIAS Y PROFESORES ───────────────────────────────────

model Subject {
  id            String   @id @default(uuid()) @db.Uuid
  code          String?  @db.VarChar(20)
  name          String   @db.VarChar(150)
  searchKey     String   @default("") @map("search_key") @db.VarChar(200)
  description   String?  @db.Text
  materialCount Int      @default(0) @map("material_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  studyPlans      StudyPlanSubject[]
  professors      SubjectProfessor[]
  materials       Material[]
  courseReviews   CourseReview[]
  examExperiences ExamExperience[]

  @@index([searchKey])
  @@map("subjects")
}

model StudyPlanSubject {
  id          String @id @default(uuid()) @db.Uuid
  studyPlanId String @map("study_plan_id") @db.Uuid
  subjectId   String @map("subject_id") @db.Uuid
  year        Int    @db.SmallInt
  semester    Int    @db.SmallInt
  credits     Int?   @db.SmallInt

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studyPlanId, subjectId])
  @@index([subjectId])
  @@map("study_plan_subjects")
}

model Professor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  bio       String?  @db.Text
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subjects        SubjectProfessor[]
  materials       Material[]
  courseReviews   CourseReview[]
  examExperiences ExamExperience[]

  @@map("professors")
}

model SubjectProfessor {
  id          String @id @default(uuid()) @db.Uuid
  subjectId   String @map("subject_id") @db.Uuid
  professorId String @map("professor_id") @db.Uuid

  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([subjectId, professorId])
  @@map("subject_professors")
}

// ─── MATERIALES ────────────────────────────────────────────────

model Material {
  id                 String               @id @default(uuid()) @db.Uuid
  title              String               @db.VarChar(200)
  searchKey          String               @default("") @map("search_key") @db.VarChar(200)
  description        String?              @db.Text
  fileUrl            String               @map("file_url") @db.VarChar(500)
  fileType           String               @map("file_type") @db.VarChar(20)
  fileSize           BigInt               @map("file_size")
  thumbnailUrl       String?              @map("thumbnail_url") @db.VarChar(500)
  authorId           String               @map("author_id") @db.Uuid
  subjectId          String               @map("subject_id") @db.Uuid
  resourceType       MaterialResourceType @default(OTRO) @map("resource_type")
  academicYear       Int?                 @map("academic_year") @db.SmallInt
  professorId        String?              @map("professor_id") @db.Uuid
  shift              Shift?
  downloadCount      Int                  @default(0) @map("download_count")
  avgRating          Decimal              @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  ratingCount        Int                  @default(0) @map("rating_count")
  publicationStatus  PublicationStatus    @default(PUBLISHED) @map("publication_status")
  statusChangedAt    DateTime             @default(now()) @map("status_changed_at")
  hiddenAt           DateTime?            @map("hidden_at")
  authorFacingReason String?              @map("author_facing_reason") @db.VarChar(1000)
  fileHash           String?              @map("file_hash") @db.Char(64)
  driveFileId        String?              @map("drive_file_id") @db.VarChar(200)
  drivePreviewUrl    String?              @map("drive_preview_url") @db.VarChar(500)
  driveDownloadUrl   String?              @map("drive_download_url") @db.VarChar(500)
  stagedFilePath     String?              @map("staged_file_path") @db.VarChar(500)
  isDeleted          Boolean              @default(false) @map("is_deleted")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  author          User                  @relation(fields: [authorId], references: [id])
  subject         Subject               @relation(fields: [subjectId], references: [id])
  professor       Professor?            @relation(fields: [professorId], references: [id], onDelete: SetNull)
  ratings         MaterialRating[]
  helpfulness     MaterialHelpfulness[]
  savedBy         SavedMaterial[]
  moderationCases ModerationCase[]
  reports         Report[]

  @@index([subjectId, publicationStatus, createdAt])
  @@index([subjectId, resourceType, publicationStatus, createdAt], map: "materials_subject_resource_status_created_idx")
  @@index([publicationStatus, searchKey])
  @@index([academicYear, publicationStatus, createdAt])
  @@index([professorId, publicationStatus, createdAt])
  @@index([shift, publicationStatus, createdAt])
  @@index([subjectId, fileHash])
  @@index([authorId])
  @@map("materials")
}

model MaterialRating {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@map("material_ratings")
}

model MaterialHelpfulness {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId, createdAt])
  @@map("material_helpfulness")
}

model SavedMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId, createdAt])
  @@map("saved_materials")
}

// ─── GUIDES ────────────────────────────────────────────────────

model Guide {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  content     String   @db.Text
  viewCount   Int      @default(0) @map("view_count")
  isPublished Boolean  @default(true) @map("is_published")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  slug        String   @unique @db.VarChar(250)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author User        @relation(fields: [authorId], references: [id])
  steps  GuideStep[]

  @@map("guides")
}

model GuideStep {
  id        String   @id @default(uuid()) @db.Uuid
  guideId   String   @map("guide_id") @db.Uuid
  title     String   @db.VarChar(100)
  content   String   @db.Text
  stepOrder Int      @map("step_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, stepOrder])
  @@map("guide_steps")
}

// ─── RESEÑAS DE CURSADA Y EXPERIENCIAS DE FINAL ────────────────

model CourseReview {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  subjectId          String               @map("subject_id") @db.Uuid
  academicYear       Int?                 @map("academic_year") @db.SmallInt
  shift              Shift                @default(NO_INDICO)
  condition          CourseCondition      @default(PREFIERO_NO_RESPONDER)
  attempt            CourseAttempt?
  professorId        String?              @map("professor_id") @db.Uuid
  professorName      String?              @map("professor_name") @db.VarChar(150)
  difficulty         CommunityDifficulty?
  recommendation     Int                  @db.SmallInt
  comment            String?              @db.Text
  isAnonymous        Boolean              @default(false) @map("is_anonymous")
  publicationStatus  PublicationStatus    @default(PUBLISHED) @map("publication_status")
  statusChangedAt    DateTime             @default(now()) @map("status_changed_at")
  hiddenAt           DateTime?            @map("hidden_at")
  authorFacingReason String?              @map("author_facing_reason") @db.VarChar(1000)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user            User             @relation("CourseReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professor       Professor?       @relation(fields: [professorId], references: [id], onDelete: SetNull)
  moderationCases ModerationCase[]
  reports         Report[]

  @@index([subjectId])
  @@index([subjectId, academicYear, createdAt], map: "course_reviews_subject_year_created_idx")
  @@index([professorId, createdAt], map: "course_reviews_professor_created_idx")
  @@index([difficulty, createdAt], map: "course_reviews_difficulty_created_idx")
  @@index([attempt, createdAt], map: "course_reviews_attempt_created_idx")
  @@index([publicationStatus, createdAt], map: "course_reviews_status_created_idx")
  @@map("course_reviews")
}

model ExamExperience {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  subjectId          String               @map("subject_id") @db.Uuid
  shift              Shift?               @map("shift")
  year               Int                  @db.SmallInt
  session            ExamSession          @default(NO_RECUERDO)
  format             ExamFormat
  examDate           DateTime?            @map("exam_date") @db.Date
  professorId        String?              @map("professor_id") @db.Uuid
  examinerName       String?              @map("examiner_name") @db.VarChar(150)
  difficulty         CommunityDifficulty?
  difficultyTheory   Int?                 @map("difficulty_theory") @db.SmallInt
  difficultyPractice Int?                 @map("difficulty_practice") @db.SmallInt
  outcome            ExamOutcome?
  grade              Int?                 @db.SmallInt
  comment            String?              @db.Text
  isAnonymous        Boolean              @default(false) @map("is_anonymous")
  publicationStatus  PublicationStatus    @default(PUBLISHED) @map("publication_status")
  statusChangedAt    DateTime             @default(now()) @map("status_changed_at")
  hiddenAt           DateTime?            @map("hidden_at")
  authorFacingReason String?              @map("author_facing_reason") @db.VarChar(1000)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user            User             @relation("ExamExperienceAuthor", fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professor       Professor?       @relation(fields: [professorId], references: [id], onDelete: SetNull)
  moderationCases ModerationCase[]
  reports         Report[]

  @@index([subjectId])
  @@index([year])
  @@index([session])
  @@index([subjectId, year, examDate, createdAt], map: "exam_experiences_subject_year_exam_date_created_idx")
  @@index([professorId, createdAt], map: "exam_experiences_professor_created_idx")
  @@index([outcome, createdAt], map: "exam_experiences_outcome_created_idx")
  @@index([difficulty, createdAt], map: "exam_experiences_difficulty_created_idx")
  @@index([publicationStatus, createdAt], map: "exam_experiences_status_created_idx")
  @@map("exam_experiences")
}

// ─── BADGES ──────────────────────────────────────────────────

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.VarChar(255)
  imageUrl    String   @map("image_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── AUTH ──────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  ip        String?   @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordResetRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_requests")
}

// ─── POINT TRANSACTIONS ────────────────────────────────────────

model PointTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Int
  reason      String   @db.VarChar(100)
  referenceId String?  @map("reference_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("point_transactions")
}

// ─── MODERATION LOG ────────────────────────────────────────────

// ─── MODERACIÓN: CASOS, REPORTES E HISTORIAL ──────────────────
// See docs/README_MODERACION.md and openspec/specs/moderation/cases.
// Raw SQL in the migration adds: exactly-one-target and target-type CHECKs, one OPEN
// case per target and kind, one report per reporter and target, and an append-only
// trigger on moderation_events.

enum ModerationTargetType {
  MATERIAL
  COURSE_REVIEW
  EXAM_EXPERIENCE
}

enum ModerationCaseKind {
  REPORTS
  PRIOR_REVIEW
}

enum ModerationCaseStatus {
  OPEN
  CLOSED
}

enum ModerationDecision {
  KEEP_VISIBLE
  REMOVE
  RESTORE
  APPROVE
  REJECT
}

enum ReportStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

enum ModerationEventAction {
  PRIOR_REVIEW_OPENED
  PRIOR_REVIEW_APPROVED
  PRIOR_REVIEW_REJECTED
  RESUBMITTED
  REPORT_FILED
  AUTO_HIDDEN
  AUTO_UNHIDDEN_OVERDUE
  KEPT_VISIBLE
  REMOVED
  RESTORED
  AUTHOR_REVEALED
  LEGACY_ACTION
}

model ModerationCase {
  id               String               @id @default(uuid()) @db.Uuid
  kind             ModerationCaseKind
  status           ModerationCaseStatus @default(OPEN)
  targetType       ModerationTargetType @map("target_type")
  materialId       String?              @map("material_id") @db.Uuid
  courseReviewId   String?              @map("course_review_id") @db.Uuid
  examExperienceId String?              @map("exam_experience_id") @db.Uuid
  highPriority     Boolean              @default(false) @map("high_priority")
  openedAt         DateTime             @default(now()) @map("opened_at")
  closedAt         DateTime?            @map("closed_at")
  decision         ModerationDecision?
  decidedById      String?              @map("decided_by_id") @db.Uuid
  decisionReason   String?              @map("decision_reason") @db.VarChar(1000)

  material       Material?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  courseReview   CourseReview?   @relation(fields: [courseReviewId], references: [id], onDelete: Cascade)
  examExperience ExamExperience? @relation(fields: [examExperienceId], references: [id], onDelete: Cascade)
  decidedBy      User?           @relation("ModerationCaseDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  reports        Report[]

  @@index([status, kind, openedAt])
  @@index([materialId])
  @@index([courseReviewId])
  @@index([examExperienceId])
  @@map("moderation_cases")
}

model Report {
  id               String               @id @default(uuid()) @db.Uuid
  caseId           String               @map("case_id") @db.Uuid
  reporterId       String               @map("reporter_id") @db.Uuid
  reason           ReportReason
  explanation      String?              @db.VarChar(1000)
  status           ReportStatus         @default(OPEN)
  targetType       ModerationTargetType @map("target_type")
  materialId       String?              @map("material_id") @db.Uuid
  courseReviewId   String?              @map("course_review_id") @db.Uuid
  examExperienceId String?              @map("exam_experience_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  resolvedAt       DateTime?            @map("resolved_at")

  case           ModerationCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter       User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  material       Material?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  courseReview   CourseReview?   @relation(fields: [courseReviewId], references: [id], onDelete: Cascade)
  examExperience ExamExperience? @relation(fields: [examExperienceId], references: [id], onDelete: Cascade)

  @@unique([reporterId, materialId])
  @@unique([reporterId, courseReviewId])
  @@unique([reporterId, examExperienceId])
  @@index([caseId])
  @@map("reports")
}

/// Append-only (a database trigger rejects UPDATE and DELETE). Target ids carry no
/// foreign keys so the history survives content deletion; `metadata` keeps a label.
model ModerationEvent {
  id               String                @id @default(uuid()) @db.Uuid
  actorId          String?               @map("actor_id") @db.Uuid
  action           ModerationEventAction
  targetType       ModerationTargetType? @map("target_type")
  materialId       String?               @map("material_id") @db.Uuid
  courseReviewId   String?               @map("course_review_id") @db.Uuid
  examExperienceId String?               @map("exam_experience_id") @db.Uuid
  targetUserId     String?               @map("target_user_id") @db.Uuid
  caseId           String?               @map("case_id") @db.Uuid
  reason           String?               @db.VarChar(1000)
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([caseId])
  @@map("moderation_events")
}
