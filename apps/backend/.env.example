# Server
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRATION=900

# Google Drive (all three values required together; leave all empty to disable)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Private persistent volume, never expose as a static folder.
COURSE_UPLOAD_STAGING_DIR=storage/course-uploads
